---
// The no-canvas rendering of the site: every word the scrollytelling canvas
// says, as ordinary scrolling markup. Served to crawlers, no-JS visitors, and
// touch/narrow viewports. Sections follow the canvas scene order (see
// `src/canvas/scenes.ts`) so the two tell the same story in the same sequence.
// The FAQ is the one exception: the canvas renders it inside the download
// scene, and here it sits just ahead of the download band so the page closes on
// the CTA rather than on a question.
//
// The gate in `Base.astro` hides this before first paint wherever the canvas
// will run, so desktop never renders a frame of it.
import { Wordmark, buttonVariants, cn } from '@myelin/ui';
import CheckList from './CheckList.astro';
import Shot from './Shot.astro';
import GuideLinks from '../GuideLinks.astro';
import { IMPORT_SOURCE_ICONS } from '../import-icons';
import {
  navLinks,
  getCopy,
  getFaqs,
  isComingSoon,
  linkHref,
  siteLinks,
} from '../../content/site';
import type { Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const faqs = getFaqs(locale);

const wrap = 'mx-auto max-w-6xl px-6 lg:px-10';
const band = 'py-24 lg:py-32';
const kicker = 'kicker text-text-muted';
const heading =
  'font-heading text-[clamp(1.9rem,3.6vw,3rem)] leading-tight font-medium tracking-[-0.01em] whitespace-pre-line text-text-primary';
const lede = 'mt-7 text-text-secondary';
const cta = cn(buttonVariants(), 'h-11 rounded-2xl px-6 text-sm');
const ctaOutline = cn(
  buttonVariants({ variant: 'outline' }),
  'h-11 rounded-2xl px-6 text-sm',
);
---

<div class="static-site relative z-10 pt-12">
  <!-- Hero -->
  <section class={wrap}>
    <div class="pt-16 pb-20 lg:pt-24 lg:pb-24">
      <p class:list={[kicker, 'rise']}>{copy.hero.eyebrow}</p>
      <h1
        class="rise mt-6 max-w-4xl font-heading text-[clamp(2.6rem,6vw,4.75rem)] leading-[1.02] font-medium tracking-[-0.02em] whitespace-pre-line text-text-primary"
        style="animation-delay:.06s"
      >
        {copy.hero.headline}
      </h1>
      <p
        class="rise mt-7 max-w-xl text-lg leading-relaxed text-text-secondary"
        style="animation-delay:.14s"
      >
        {copy.hero.subheadline}
      </p>
      <div
        class="rise mt-10 flex flex-wrap items-center gap-x-4 gap-y-4"
        style="animation-delay:.22s"
      >
        <a href={siteLinks.releases} data-download="auto" class={cta}>
          {copy.hero.ctaPrimary}
        </a>
        <a href="#pdfs" class={ctaOutline}>{copy.hero.ctaSecondary}</a>
      </div>
      <p class="rise mt-7 text-sm text-text-muted" style="animation-delay:.28s">
        {copy.hero.trustLine}
      </p>

      <div class="rise mt-16 lg:mt-20" style="animation-delay:.36s">
        <Shot src="/library.png" alt={copy.shots.library} eager />
      </div>
    </div>
  </section>

  <!-- PDFs -->
  <section id="pdfs" class="bg-surface">
    <div class:list={[wrap, band]}>
      <div class="grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5">
          <p class={kicker}>01 / {copy.sceneLabels.ink}</p>
          <h2 class:list={[heading, 'mt-6']}>{copy.ink.pdfHeading}</h2>
          <p class={lede}>{copy.ink.pdfBody}</p>
          {locale === 'en' && (
            <p class="mt-5"><a href="/guides/linux-handwriting-notes/" class="text-text-secondary underline underline-offset-4">Handwriting and PDF notes on Linux</a></p>
          )}
        </div>
        <div class="md:col-span-6 md:pl-6 lg:col-span-7">
          <Shot src="/pdf.png" alt={copy.shots.pdf} />
        </div>
      </div>
    </div>
  </section>

  <!-- Page frames -->
  <section class:list={[wrap, band]}>
    <div class="grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
      <div class="order-2 md:order-1 md:col-span-6 md:pr-6 lg:col-span-7">
        <Shot src="/page-frame.png" alt={copy.shots.pageFrame} />
      </div>
      <div class="order-1 md:order-2 md:col-span-6 lg:col-span-5">
        <p class={kicker}>02 / {copy.sceneLabels.pages}</p>
        <h2 class:list={[heading, 'mt-6']}>{copy.pages.heading}</h2>
        <p class={lede}>{copy.pages.body}</p>
      </div>
    </div>
  </section>

  <!-- Audio and search -->
  <section class="bg-surface">
    <div class:list={[wrap, band]}>
      <div class="grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5">
          <p class={kicker}>03 / {copy.sceneLabels['audio-search']}</p>
          <h2 class:list={[heading, 'mt-6']}>{copy.audioSearch.heading}</h2>
          <p class={lede}>{copy.audioSearch.audioBody}</p>
          <p class={lede}>{copy.audioSearch.searchBody}</p>
        </div>
        <div class="grid gap-5 md:col-span-6 md:pl-6 lg:col-span-7">
          <Shot src="/audio.png" alt={copy.shots.audio} />
        </div>
      </div>
    </div>
  </section>

  <!-- Linked notes -->
  <section class:list={[wrap, band]}>
    <div class="grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
      <div class="order-2 md:order-1 md:col-span-6 md:pr-6 lg:col-span-7">
        <Shot src="/graph.png" alt={copy.shots.graph} />
      </div>
      <div class="order-1 md:order-2 md:col-span-6 lg:col-span-5">
        <p class={kicker}>04 / {copy.sceneLabels.linked}</p>
        <h2 class:list={[heading, 'mt-6']}>{copy.linked.heading}</h2>
        <p class={lede}>{copy.linked.body}</p>
      </div>
    </div>
  </section>

  <!-- Sync and collaboration -->
  <section id="sync" class="bg-surface">
    <div class:list={[wrap, band]}>
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5">
          <p class={kicker}>05 / {copy.sceneLabels.sync}</p>
          <h2 class:list={[heading, 'mt-6']}>{copy.sync.heading}</h2>
          <p class={lede}>{copy.sync.kicker}</p>
        </div>
        <div class="grid gap-5 md:col-span-6 md:pl-6 lg:col-span-7">
          {
            copy.sync.tiers.map((tier) => (
              <div class="rounded-3xl bg-card p-7 shadow-elevated lg:p-8">
                <span class="rounded-full bg-tag px-2.5 py-1 text-xs font-medium text-text-tag">
                  {tier.badge}
                </span>
                <h3 class="mt-4 font-heading text-xl font-medium text-text-primary">
                  {tier.title}
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">
                  {tier.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Local-first -->
  <section id="local" class:list={[wrap, band]}>
    <div class="grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
      <div class="md:col-span-6 lg:col-span-5">
        <p class={kicker}>06 / {copy.sceneLabels['local-first']}</p>
        <h2 class:list={[heading, 'mt-6']}>{copy.localFirst.heading}</h2>
        <p class={lede}>{copy.localFirst.lede}</p>
        {locale === 'en' && (
          <p class="mt-5"><a href="/guides/offline-notes/" class="text-text-secondary underline underline-offset-4">What works offline in Myelin Notes?</a></p>
        )}
      </div>
      <CheckList
        items={copy.localFirst.bullets}
        class="md:col-span-6 md:pl-6 lg:col-span-7"
      />
    </div>
  </section>

  <!-- Import -->
  <section id="import" class="bg-surface">
    <div class:list={[wrap, band]}>
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5">
          <p class={kicker}>07 / {copy.sceneLabels.import}</p>
          <h2 class:list={[heading, 'mt-6']}>{copy.importing.heading}</h2>
          <p class={lede}>{copy.importing.body}</p>
          {locale === 'en' && (
            <p class="mt-5"><a href="/guides/import-onenote/" class="text-text-secondary underline underline-offset-4">How to import OneNote notebooks and sections</a></p>
          )}
        </div>
        <div class="grid gap-5 md:col-span-6 md:pl-6 lg:col-span-7">
          {
            copy.importing.sources.map((source) => {
              const Icon = IMPORT_SOURCE_ICONS[source.id];
              return (
                <div class="flex items-center gap-5 rounded-3xl bg-card p-7 shadow-elevated">
                  <Icon className="size-10 shrink-0" />
                  <div class="min-w-0">
                    <h3 class="font-heading text-lg font-medium text-text-primary">
                      {source.label}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
                      {source.detail}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class:list={[wrap, band]}>
    <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12">
      <p class:list={[kicker, 'lg:col-span-3']}>08 / {copy.faqKicker}</p>
      <h2 class:list={[heading, 'lg:col-span-9']}>{copy.download.faqTitle}</h2>
    </div>
    {/* Two columns from `sm` up, not `lg`: this page only ever renders below
        the canvas breakpoint, so an `lg` column split would never fire and the
        answers would read as one undifferentiated column. The rules keep the
        entries separated at phone widths, where it is one column regardless. */}
    <dl class="mt-12 grid gap-x-10 sm:mt-16 sm:grid-cols-2">
      {
        faqs.map((faq) => (
          <div class="border-t border-border-divider py-7">
            <dt class="text-lg font-semibold text-text-primary">
              {faq.question}
            </dt>
            <dd class="mt-3 max-w-md text-text-secondary">{faq.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Download -->
  <section id="download" class="bg-primary text-text-on-dark">
    <div class:list={[wrap, 'py-28 lg:py-36']}>
      <p class="kicker text-text-on-dark/55">
        09 / {copy.sceneLabels.download}
      </p>
      <h2
        class="mt-6 max-w-3xl font-heading text-[clamp(2.2rem,4.5vw,4rem)] leading-[1.04] font-medium tracking-[-0.015em] whitespace-pre-line"
      >
        {copy.download.heading}
      </h2>
      <p class="mt-7 max-w-2xl text-text-on-dark/75">{copy.download.body}</p>
      {/* One call to action, then the platforms as detail. This page is
          prerendered, so the OS-specific href is filled in by the script at the
          bottom of this file rather than at build time. */}
      <a
        href={siteLinks.releases}
        data-download="auto"
        class="mt-12 inline-flex h-12 items-center rounded-2xl bg-white px-7 text-sm font-semibold text-text-primary transition-colors hover:bg-white/85"
      >
        {copy.download.cta}
      </a>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          copy.download.platforms
            .filter((platform) => !isComingSoon(platform.key))
            .map((platform) => (
              <a
                href={siteLinks.releases}
                data-download={platform.key}
                class="rounded-xl bg-white/10 px-5 py-2.5 text-sm text-text-on-dark transition-colors hover:bg-white/20"
              >
                <span class="font-medium">{platform.name}</span>
                <span class="ml-2 opacity-60">{platform.sub}</span>
              </a>
            ))
        }
      </div>
      {/* Listed, but as plain chips: there is no build to link to yet. */}
      <p class="mt-10 text-sm text-text-on-dark/55">
        {copy.download.comingSoon}
      </p>
      <div class="mt-3 flex flex-wrap gap-3">
        {
          copy.download.platforms
            .filter((platform) => isComingSoon(platform.key))
            .map((platform) => (
              <span class="rounded-xl border border-white/20 px-5 py-2.5 text-sm text-text-on-dark/60">
                <span class="font-medium">{platform.name}</span>
                <span class="ml-2 opacity-70">{platform.sub}</span>
              </span>
            ))
        }
      </div>
      <p class="mt-10 text-sm text-text-on-dark/55">
        {copy.download.mobileBadge}
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class={wrap}>
    {locale === 'en' && <GuideLinks />}
    <div class="grid gap-10 py-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Wordmark className="text-[1.35rem]" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
          {copy.footer.tagline}
        </p>
      </div>
      <nav class="lg:col-span-7" aria-label={copy.footer.nav}>
        <ul class="flex flex-wrap gap-x-8 gap-y-3">
          {locale === 'en' && (
            <li><a href={siteLinks.source} class="text-sm text-text-secondary transition-colors hover:text-text-primary">Myelin Notes on GitHub</a></li>
          )}
          {
            navLinks.map((id) => (
              <li>
                <a
                  href={linkHref(id)}
                  class="text-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  {copy.linkLabels[id]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="h-px w-full bg-border-ghost"></div>
    <div
      class="flex flex-wrap items-center justify-between gap-4 py-10 text-sm text-text-muted"
    >
      <p class="kicker">{copy.footer.platforms}</p>
    </div>
  </footer>
</div>

<script>
  import {
    autoDownloadUrl,
    detectPlatform,
    fetchDownloadUrls,
  } from '../../lib/downloads';
  import type { PlatformKey } from '../../content/site/links';

  // Every download link ships pointing at the releases page; upgrade the ones
  // whose platform has a real installer in the latest release. "auto" means the
  // link is a bare "Download", so it follows the visitor's OS. Anything left
  // unresolved (no JS, GitHub unreachable) keeps the releases page, which is a
  // working destination on its own.
  void fetchDownloadUrls().then((urls) => {
    const detected = detectPlatform();
    const links =
      document.querySelectorAll<HTMLAnchorElement>('a[data-download]');
    for (const link of links) {
      const attr = link.dataset.download;
      const url =
        attr === 'auto'
          ? autoDownloadUrl(urls, detected)
          : urls[attr as PlatformKey];
      if (url) {
        link.href = url;
      }
    }
  });
</script>
