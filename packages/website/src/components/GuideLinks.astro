---
import { guides } from '../content/guides';

const related = guides.filter((guide) => guide.href !== Astro.url.pathname);
---

<nav aria-label="Myelin Notes guides" class="py-12">
  <h2 class="font-heading text-2xl font-medium text-text-primary">Myelin Notes guides</h2>
  <ul class="mt-6 grid gap-6 md:grid-cols-3">
    {related.map((guide) => (
      <li>
        <a href={guide.href} class="font-medium text-text-primary underline underline-offset-4">
          {guide.title}
        </a>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">{guide.description}</p>
      </li>
    ))}
  </ul>
</nav>
