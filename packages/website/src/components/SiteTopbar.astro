---
// App-chrome style top bar, fixed above the full-screen canvas. Static markup
// only: CanvasEditor intercepts the Download link and flies the camera to the
// download scene, since the canvas is the whole page with no anchor to jump to.
//
// Being outside the island is what lets one language picker serve both
// renderings: the canvas and the static page share this bar.
import { getCopy, linkHref, navLinks } from '../content/site';
import { guides } from '../content/guides';
import {
  LOCALES,
  type Locale,
  localeNames,
  localizePath,
  splitLocalePath,
} from '../lib/locale';

interface Props {
  locale: Locale;
  /** False on pages published in one language only, which hides the picker. */
  translated?: boolean;
}

const { locale, translated = true } = Astro.props;
const copy = getCopy(locale);

// The route the current URL maps to in another language, so the picker keeps
// you on the page you are reading rather than dropping you at the home page.
const { path } = splitLocalePath(Astro.url.pathname);
---

<header class="site-topbar">
  <a href={localizePath('/', locale)} class="wordmark">Myelin Notes</a>
  <nav class="topbar-nav" aria-label={copy.topbar.nav}>
    {locale === 'en' && (
      <details class="relative text-sm text-text-secondary">
        <summary class="cursor-pointer">Guides</summary>
        <ul class="absolute right-0 top-full mt-3 w-72 rounded-xl border border-border-divider bg-card p-3 shadow-elevated">
          {guides.map((guide) => (
            <li><a href={guide.href} class="block rounded-lg px-3 py-2 hover:bg-hover-tint">{guide.title}</a></li>
          ))}
        </ul>
      </details>
    )}
    {
      navLinks.map((id) => (
        <a href={linkHref(id)}>{copy.linkLabels[id]}</a>
      ))
    }
  </nav>
  {
    translated && (
      /* `details` rather than a scripted menu: the canvas island owns the
         page's JavaScript budget, and this needs none. */
      <details class="lang-picker">
        <summary aria-label={copy.topbar.language}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
          </svg>
          <span>{localeNames[locale]}</span>
        </summary>
        <ul>
          {LOCALES.map((code) => (
            <li>
              <a
                href={localizePath(path, code)}
                hreflang={code}
                aria-current={code === locale ? 'true' : undefined}
              >
                {localeNames[code]}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
  <a
    href={`${localizePath('/', locale)}#download`}
    class="topbar-download"
    data-download-platform-jump
  >
    {copy.topbar.download}
  </a>
</header>

{
  translated && (
    /* A `details` element only closes on its own summary, and on the canvas
       every other click lands on a canvas layer that never bubbles a close. */
    <script is:inline>
      document.addEventListener('pointerdown', (event) => {
        const picker = document.querySelector('.lang-picker[open]');
        if (picker && !picker.contains(event.target)) {
          picker.removeAttribute('open');
        }
      });
    </script>
  )
}
