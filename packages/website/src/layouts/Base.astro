---
import Seo from '../components/Seo.astro';
import SiteTopbar from '../components/SiteTopbar.astro';
import { getCopy } from '../content/site';
import { type Locale, localeTags } from '../lib/locale';
import '../styles/global.css';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** False on pages published in one language only (the privacy policy). */
  translated?: boolean;
  canvas?: boolean;
}

const {
  title,
  locale,
  description = getCopy(locale).meta.description,
  image,
  jsonLd,
  translated = true,
  canvas = true,
} = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('#organization', Astro.site).href,
  name: 'Myelin Notes',
  url: Astro.site?.href,
  sameAs: ['https://github.com/myelin-notes'],
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link
      rel="preload"
      href="/fonts/caveat-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <!-- Marks environments the canvas will run in, before the body is parsed,
         so the static page is hidden without ever painting a frame of it.
         `is:inline` is required: a processed script is deferred and would run
         after the first paint, which is the flash this exists to prevent. -->
    {canvas && (
      <script is:inline>
        if (matchMedia('(pointer: fine)').matches && innerWidth >= 1024) {
          document.documentElement.classList.add('canvas-env');
        }
      </script>
    )}
    <Seo
      title={title}
      description={description}
      image={image}
      translated={translated}
      jsonLd={[organization, ...pageJsonLd]}
    />
    <script>
      import { initWebAnalytics } from '../lib/posthog';

      // Hold analytics until the main thread is free, so PostHog neither
      // downloads nor executes while the canvas bundle is still landing. The
      // timeout is the backstop for a page that never goes idle.
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void initWebAnalytics(), { timeout: 5000 });
      } else {
        setTimeout(() => void initWebAnalytics(), 2000);
      }
    </script>
  </head>
  <body>
    <SiteTopbar locale={locale} translated={translated} />
    <slot />
  </body>
</html>
