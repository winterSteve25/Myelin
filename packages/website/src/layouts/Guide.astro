---
import Base from './Base.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { siteLinks } from '../content/site/links';

interface Props {
  title: string;
  heading: string;
  description: string;
}

const { title, heading, description } = Astro.props;
---

<Base locale="en" translated={false} canvas={false} title={title} description={description}>
  <main class="mx-auto max-w-4xl px-6 pt-24 pb-12 lg:px-10">
    <article>
      <header class="mb-12">
        <a href="/" class="kicker text-text-secondary underline underline-offset-4">Myelin Notes</a>
        <h1 class="mt-5 font-heading text-[clamp(2.2rem,4.5vw,3.4rem)] leading-tight font-medium tracking-tight text-text-primary">{heading}</h1>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">{description}</p>
      </header>
      <div class="guide-content"><slot /></div>
    </article>
    <aside class="mt-12 rounded-2xl bg-surface p-8">
      <h2 class="font-heading text-2xl font-medium">Try Myelin Notes</h2>
      <p class="mt-3 text-text-secondary">Available for Mac, Windows, and Linux. Free for personal use, with no Myelin account required.</p>
      <a href={siteLinks.releases} class="mt-6 inline-flex rounded-xl bg-primary px-5 py-3 font-medium text-primary-foreground">Download Myelin Notes</a>
    </aside>
    <GuideLinks />
    <footer class="flex flex-wrap gap-6 border-t border-border-divider pt-8 text-sm text-text-secondary">
      <a href="/">Myelin Notes</a>
      <a href={siteLinks.source}>Source on GitHub</a>
      <a href="/support/">Support</a>
      <a href="/privacy/">Privacy</a>
    </footer>
  </main>
</Base>

<style>
  .guide-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .guide-content :global(p),
  .guide-content :global(ul),
  .guide-content :global(ol) {
    margin-block: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .guide-content :global(ul),
  .guide-content :global(ol) {
    padding-left: 1.5rem;
  }
  .guide-content :global(ul) { list-style: disc; }
  .guide-content :global(ol) { list-style: decimal; }
  .guide-content :global(li) { margin-block: 0.75rem; }
  .guide-content :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .guide-content :global(figure) { margin-block: 2rem; }
  .guide-content :global(figcaption) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .guide-content :global(table) {
    width: 100%;
    margin-block: 1.5rem;
    text-align: left;
    line-height: 1.6;
  }
  .guide-content :global(th),
  .guide-content :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-divider);
    vertical-align: top;
  }
</style>
