    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "react-devtools-core": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "3.2.6"
  }
