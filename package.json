{
  "name": "myelin",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/editor",
    "packages/shared",
    "packages/ui",
    "packages/website"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/posthog-sourcemaps.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/editor && tsc --noEmit -p packages/shared",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ios:device": "node scripts/ios-device.mjs",
    "tauri": "node ./scripts/tauri.mjs",
    "tauri:mac-deep-links:check": "node scripts/tauri-deep-links.mjs check",
    "tauri:mac-deep-links:clear": "node scripts/tauri-deep-links.mjs clear",
    "website:dev": "yarn workspace @myelin/website dev",
    "website:build": "yarn workspace @myelin/website build",
    "prepare": "husky"
  },
  "resolutions": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@chenglou/pretext": "^0.0.5",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@myelin/editor": "*",
    "@myelin/shared": "*",
    "@myelin/ui": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "~2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@ungap/structured-clone": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "katex": "^0.17.0",
    "lucide-react": "^0.577.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "posthog-js": "^1.392.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
